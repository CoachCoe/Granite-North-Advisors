---
import MountainMark from './MountainMark.astro';
import { company, unblocker } from '../site.config';

interface Props {
  /** Prefix for in-page links. Pass "/" on pages other than the home page. */
  base?: string;
}
const { base = '' } = Astro.props;

const onUnblocker = Astro.url.pathname.startsWith(unblocker.path);

const links = [
  { href: `${base}#services`, label: 'What we do', current: false },
  { href: `${base}#approach`, label: 'How we work', current: false },
  { href: `${base}#team`, label: 'Who we are', current: false },
  { href: `${base}#request`, label: 'Get started', current: false },
  { href: unblocker.path, label: unblocker.name, current: onUnblocker },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={base ? '/' : '#top'}>
      <span class="mark"><MountainMark /></span>
      <span class="wordmark">{company.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-ground);
  }

  .bar {
    padding-top: 20px;
    padding-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .mark { color: var(--color-accent); flex: none; }

  .wordmark {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.01em;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    font-size: var(--text-small);
    font-weight: 600;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-ink);
  }

  nav a:hover { color: var(--color-accent); }

  nav a[aria-current='page'] {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  @media (max-width: 480px) {
    ul { gap: 0 20px; }
  }
</style>
