---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  slug: string;
}
const { name, slug } = Astro.props;

const photos = import.meta.glob<ImageMetadata>('/src/assets/team/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const photo = Object.entries(photos).find(([path]) =>
  path.replace(/^.*\//, '').replace(/\.\w+$/, '') === slug,
)?.[1];
---
{photo ? (
  <Picture
    class="headshot"
    src={photo}
    alt={name}
    width={224}
    height={224}
    fit="cover"
    formats={['avif', 'webp']}
    loading="lazy"
    decoding="async"
  />
) : (
  <div class="headshot placeholder" role="img" aria-label={`Photo placeholder for ${name}`}>[PHOTO]</div>
)}

<style>
  .headshot {
    display: block;
    width: 112px;
    height: 112px;
    margin-bottom: 20px;
    border-radius: 999px;
    object-fit: cover;
  }

  .placeholder {
    background: var(--color-placeholder);
    border: 1px dashed var(--color-placeholder-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-muted);
  }
</style>
