---
import { unblocker, waitlistHref } from '../../site.config';

const facts = [
  {
    label: 'Our goal',
    value: 'Same day',
    caption: 'From an uploaded questionnaire to a draft you can review. A target for the beta, not a promise.',
  },
  {
    label: 'Planned beta price',
    value: `$${unblocker.betaPriceMonthly}/mo`,
    caption: 'Founding-member rate, month to month. Subject to change before launch.',
  },
  {
    label: 'Full compliance platforms, from',
    value: '~$7,500/yr',
    caption: 'Quote-based, plus auditor fees. Reported entry pricing; see the note below.',
  },
];
---
<section id="top" class="container hero" aria-labelledby="u-hero-title">
  <p class="pill">In development · Beta waitlist open</p>
  <h1 id="u-hero-title">Close enterprise deals before you have SOC 2.</h1>
  <p class="intro">
    A buyer sends a long security questionnaire and your deal stops. A full compliance platform costs thousands and takes months. We're building a faster way: honest answers checked against your real setup, and a security packet you can send the buyer, all organized so it counts toward a future audit.
  </p>
  <div class="actions">
    <a class="u-btn u-btn-primary" href={waitlistHref}>Join the beta waitlist</a>
    <a class="u-btn u-btn-secondary" href="#how">See how it will work</a>
  </div>
  <p class="note">We're building this now. Joining the waitlist is free, and nothing is charged.</p>

  <ul class="facts">
    {facts.map((fact) => (
      <li>
        <p class="label">{fact.label}</p>
        <p class="value">{fact.value}</p>
        <p class="caption">{fact.caption}</p>
      </li>
    ))}
  </ul>
  <p class="footnote">Pricing note: vendors quote prices individually, so your number will differ. Entry figures come from third-party comparisons by <a href="https://cipherssecurity.com/vanta-vs-drata-pricing-2026/" rel="noopener noreferrer">Cipher Security</a> and <a href="https://underdefense.com/blog/compliance-automation-pricing/" rel="noopener noreferrer">UnderDefense</a>.</p>
</section>

<style>
  .hero {
    padding-top: var(--section-pad);
    padding-bottom: 72px;
  }

  .pill {
    margin: 0 0 24px;
    display: inline-flex;
    align-items: center;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-pill-border);
    border-radius: 999px;
    padding: 6px 16px;
    background: var(--color-surface);
  }

  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--text-h1);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 920px;
  }

  .intro {
    margin: 28px 0 0;
    max-width: 760px;
    font-size: var(--text-lead);
    color: var(--color-body);
  }

  .actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .note {
    margin: 20px 0 0;
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .facts {
    margin: 64px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 20px;
  }

  .facts li {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 28px;
  }

  .label {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-muted);
  }

  .value {
    margin: 6px 0 8px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .caption {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-body);
  }

  .footnote {
    margin: 20px 0 0;
    max-width: 760px;
    font-size: 15px;
    color: var(--color-muted);
  }

  @media (max-width: 480px) {
    .pill { border-radius: 20px; }
  }
</style>
