---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Approach from '../components/Approach.astro';
import Example from '../components/Example.astro';
import Team from '../components/Team.astro';
import GetStarted from '../components/GetStarted.astro';
import Footer from '../components/Footer.astro';

const title = 'Granite North Advisors · Healthcare tech, billing and security help for rural NH practices';
const description = 'We help rural New Hampshire practices fix their tech, get paid for their work, and stay safe from hackers. No cost with Rural Health Transformation money.';
---
<Base title={title} description={description}>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Services />
    <Approach />
    <Example />
    <Team />
    <GetStarted />
  </main>
  <Footer />
</Base>
